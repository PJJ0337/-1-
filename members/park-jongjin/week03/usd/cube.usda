#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "Cube" (
        customData = {
            string note = "week03 cube"
        }
    )
    {
        color3f[] primvars:displayColor = [(0.2, 0.5, 0.9)]
        double size = 0.2
        double3 xformOp:translate = (0, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

