<!-- week03 화요일: 장면 파일. 로봇 파일은 include 로 분리 (USD reference 와 같은 역할)
     실행: python -m mujoco.viewer --mjcf=members/park-jongjin/week03/mjcf/scene.xml -->
<mujoco model="two_link_arm_scene">
  <include file="two_link_arm.xml"/>

  <option timestep="0.002" integrator="implicitfast" gravity="0 0 -9.81"/>

  <visual>
    <global azimuth="90" elevation="-10"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <!-- worldbody 를 한 번 더 써도 된다: include 된 파일의 worldbody 와 합쳐짐 -->
  <worldbody>
    <light pos="0 -1 1.5" dir="0 1 -1"/>
    <geom name="floor" type="plane" size="1 1 0.05" material="grid" pos="0 0 -0.6"/>
  </worldbody>
</mujoco>
