<!-- week03 수요일: scene.xml + position 액추에이터
     기본값: kp 50, kv 1, forcerange = URDF effort(±40 / ±20 Nm), ctrlrange = 관절 range
     계단 응답 실험(scripts/wed_step_response.py)에서 kp · kv · armature 를 Python으로 바꿔 가며 비교
     MuJoCo position 액추에이터 힘: f = kp·(ctrl − q) − kv·q̇   (gainprm[0]=kp, biasprm = [0, −kp, −kv]) -->
<mujoco model="two_link_arm_position">
  <include file="scene.xml"/>

  <default>
    <default class="servo">
      <position kp="50" kv="1"/>
    </default>
  </default>

  <actuator>
    <position name="shoulder_pos" class="servo" joint="shoulder" ctrlrange="-1.5708 1.5708" forcerange="-40 40"/>
    <position name="elbow_pos"    class="servo" joint="elbow"    ctrlrange="-2.3562 2.3562" forcerange="-20 20"/>
  </actuator>

  <sensor>
    <jointpos name="shoulder_q" joint="shoulder"/>
    <actuatorfrc name="shoulder_tau" actuator="shoulder_pos"/>
  </sensor>
</mujoco>
